# Copy to web_demo/.env for local use. Never commit real credentials.
RESEARCHTWIN_MCP_URL=https://researcp-remote-rfxkxlnciq.cn-beijing.fcapp.run/mcp
RESEARCHTWIN_MCP_TOKEN=<set-locally-and-never-commit>
RESEARCHTWIN_DEMO_PROJECT=ResearchTwin
RESEARCHTWIN_MCP_TIMEOUT_SECONDS=20
RESEARCHTWIN_DEMO_HOST=127.0.0.1
RESEARCHTWIN_DEMO_PORT=8080

# Optional Bailian Research Intelligence Workflow settings. Never commit a real API key.
BAILIAN_WORKFLOW_APP_ID=<set-locally>
DASHSCOPE_API_KEY=<set-locally-and-never-commit>
BAILIAN_WORKFLOW_TIMEOUT_SECONDS=600
# BAILIAN_WORKSPACE_ID=<optional-default-business-space>

# Local Assistant model settings. The model defaults to qwen3.6-plus.
DASHSCOPE_MODEL=qwen3.6-plus
DASHSCOPE_CHAT_TIMEOUT_SECONDS=120

# Existing ResearchTwin_Docs Bailian knowledge base retrieval settings.
ALIBABA_CLOUD_ACCESS_KEY_ID=<set-locally-and-never-commit>
ALIBABA_CLOUD_ACCESS_KEY_SECRET=<set-locally-and-never-commit>
RESEARCHTWIN_BAILIAN_WORKSPACE_ID=<set-locally>
RESEARCHTWIN_BAILIAN_INDEX_ID=<set-locally>
# RESEARCHTWIN_BAILIAN_ENDPOINT=<optional-existing-endpoint>

# ResearchTwin_Docs provider: local is the stable FC/public-runtime default;
# opentrek is for local validation only.
RESEARCHTWIN_RAG_PROVIDER=local
RESEARCHTWIN_LOCAL_RAG_INDEX=web_demo/knowledge/researchtwin_docs_index.json
OPENTREK_APP_KEY=<set-locally-and-never-commit>
OPENTREK_KB_URL=<set-locally>
OPENTREK_WORKSPACE_CODE=<set-locally>
OPENTREK_KB_INDEX_CODE=<set-locally>
OPENTREK_KB_RETRIEVE_FIELD=chunk_representation
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# DASHSCOPE_EMBEDDING_ENDPOINT=<optional-existing-compatible-endpoint>
