# Copy this file to .env for local configuration. Existing process environment
# variables take precedence over values in .env, and .env is ignored by Git.

# Network settings for the MCP server. A native Linux deployment behind Nginx
# should use loopback-only binding. The code default remains 0.0.0.0 for an
# explicitly configured trusted-LAN demonstration.
RESEARCHTWIN_HOST=127.0.0.1
RESEARCHTWIN_PORT=8000

# Relative paths are resolved from the repository root. Production deployment
# should use an absolute data directory outside or explicitly ignored by Git.
RESEARCHTWIN_DATA_DIR=runtime_data
RESEARCHTWIN_LOG_LEVEL=INFO
