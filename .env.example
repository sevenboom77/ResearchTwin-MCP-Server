# Copy this file to .env for local configuration. Existing process environment
# variables take precedence over values in .env, and .env is ignored by Git.

# Network settings for the MCP server
RESEARCHTWIN_HOST=0.0.0.0
RESEARCHTWIN_PORT=8000

# Relative paths are resolved from the repository root.
RESEARCHTWIN_DATA_DIR=runtime_data
RESEARCHTWIN_LOG_LEVEL=INFO
